<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>DeepSeek 智能助手</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: #f5f7fa;
            height: 100vh;
            display: flex;
            flex-direction: column;
            max-width: 600px;
            margin: 0 auto;
            padding: 16px;
        }
        h1 {
            font-size: 22px;
            color: #1a1a2e;
            text-align: center;
            padding: 12px 0 8px;
            border-bottom: 1px solid #e8ecf1;
            flex-shrink: 0;
        }
        .api-section {
            display: flex;
            gap: 8px;
            padding: 12px 0;
            flex-shrink: 0;
        }
        .api-section input {
            flex: 1;
            padding: 10px 14px;
            border: 1px solid #d0d5dd;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            background: white;
        }
        .api-section input:focus {
            border-color: #4f6ef7;
        }
        .api-section input::placeholder {
            color: #b0b8c4;
        }
        .api-section button {
            padding: 10px 18px;
            background: #4f6ef7;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            white-space: nowrap;
            font-weight: 500;
        }
        .api-section button:active {
            opacity: 0.7;
        }
        .chat-box {
            flex: 1;
            background: white;
            border-radius: 12px;
            padding: 16px;
            overflow-y: auto;
            border: 1px solid #e8ecf1;
            min-height: 300px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .message {
            max-width: 85%;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 15px;
            line-height: 1.6;
            word-wrap: break-word;
            animation: fadeIn 0.3s ease;
        }
        .message.user {
            align-self: flex-end;
            background: #4f6ef7;
            color: white;
            border-bottom-right-radius: 4px;
        }
        .message.assistant {
            align-self: flex-start;
            background: #f0f2f5;
            color: #1a1a2e;
            border-bottom-left-radius: 4px;
        }
        .message.error {
            align-self: center;
            background: #fee2e2;
            color: #dc2626;
            font-size: 13px;
            max-width: 90%;
            text-align: center;
        }
        .message .loading-dots::after {
            content: '...';
            animation: dots 1.5s steps(4, end) infinite;
        }
        @keyframes dots {
            0% { content: ''; }
            25% { content: '.'; }
            50% { content: '..'; }
            75% { content: '...'; }
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .input-section {
            display: flex;
            gap: 8px;
            padding: 12px 0 0;
            flex-shrink: 0;
        }
        .input-section textarea {
            flex: 1;
            padding: 10px 14px;
            border: 1px solid #d0d5dd;
            border-radius: 8px;
            font-size: 15px;
            resize: none;
            outline: none;
            font-family: inherit;
            min-height: 48px;
            max-height: 120px;
            background: white;
        }
        .input-section textarea:focus {
            border-color: #4f6ef7;
        }
        .input-section button {
            padding: 10px 20px;
            background: #4f6ef7;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            cursor: pointer;
            font-weight: 500;
            flex-shrink: 0;
            height: 48px;
        }
        .input-section button:active {
            opacity: 0.7;
        }
        .input-section button:disabled {
            background: #b0b8c4;
            cursor: not-allowed;
        }
        .status-tip {
            text-align: center;
            font-size: 12px;
            color: #9aa3b2;
            padding: 4px 0;
            flex-shrink: 0;
        }
        .clear-btn {
            background: none;
            border: none;
            color: #9aa3b2;
            font-size: 12px;
            cursor: pointer;
            padding: 4px 12px;
            float: right;
        }
        .clear-btn:active {
            color: #dc2626;
        }
        /* 适配全面屏和刘海屏 */
        @supports (padding: max(0px)) {
            body {
                padding-left: max(16px, env(safe-area-inset-left));
                padding-right: max(16px, env(safe-area-inset-right));
                padding-top: max(16px, env(safe-area-inset-top));
                padding-bottom: max(16px, env(safe-area-inset-bottom));
            }
        }
    </style>
</head>
<body>

    <h1>🤖 DeepSeek 助手</h1>

    <!-- API Key 输入区域 -->
    <div class="api-section">
        <input type="password" id="apiKeyInput" placeholder="sk-84360e9e33264620898a6417134f4555" />
        <button id="saveKeyBtn">保存</button>
    </div>

    <!-- 聊天消息显示区域 -->
    <div class="chat-box" id="chatBox">
        <div class="message assistant">👋 你好！请在上方输入你的 API Key 开始对话。</div>
    </div>

    <!-- 状态提示 -->
    <div class="status-tip" id="statusTip">💡 模型: DeepSeek-V3</div>

    <!-- 输入区域 -->
    <div class="input-section">
        <textarea id="userInput" rows="1" placeholder="输入消息..." disabled></textarea>
        <button id="sendBtn" disabled>发送</button>
    </div>

    <script>
        // ====== 获取 DOM 元素 ======
        const apiKeyInput = document.getElementById('apiKeyInput');
        const saveKeyBtn = document.getElementById('saveKeyBtn');
        const chatBox = document.getElementById('chatBox');
        const userInput = document.getElementById('userInput');
        const sendBtn = document.getElementById('sendBtn');
        const statusTip = document.getElementById('statusTip');

        // ====== 存储 API Key（保存在浏览器本地） ======
        let API_KEY = localStorage.getItem('deepseek_api_key') || '';

        // 如果已有保存的 Key，填入输入框
        if (API_KEY) {sk-84360e9e33264620898a6417134f4555
            apiKeyInput.value = API_KEY;
            enableChat(true);
            addMessage('assistant', '✅ API Key 已加载，可以开始对话了！');
        }

        // ====== 保存 API Key ======
        saveKeyBtn.addEventListener('click', function() {
            const key = apiKeyInput.value.trim();
            if (!key) {
                alert('请输入有效的 API Key');
                return;
            }
            if (!key.startsWith('sk-')) {
                alert('⚠️ API Key 格式不正确，应该以 sk- 开头');
                return;
            }
            API_KEY = key;
            localStorage.setItem('deepseek_api_key', key);
            enableChat(true);
            addMessage('assistant', '✅ API Key 保存成功！可以开始聊天了。');
            // 清空可能的历史错误提示
            const errors = chatBox.querySelectorAll('.message.error');
            errors.forEach(el => el.remove());
        });

        // ====== 启用/禁用聊天控件 ======
        function enableChat(enabled) {
            userInput.disabled = !enabled;
            sendBtn.disabled = !enabled;
            if (enabled) {
                userInput.focus();
                statusTip.textContent = '💡 模型: DeepSeek-V3 | 已就绪';
                statusTip.style.color = '#4f6ef7';
            } else {
                statusTip.textContent = '⏳ 请先输入 API Key';
                statusTip.style.color = '#9aa3b2';
            }
        }

        // ====== 添加消息到聊天框 ======
        function addMessage(role, content) {
            const div = document.createElement('div');
            div.className = 'message ' + role;
            // 处理换行
            div.innerHTML = content.replace(/\n/g, '<br>');
            chatBox.appendChild(div);
            chatBox.scrollTop = chatBox.scrollHeight;
            return div;
        }

        // ====== 显示加载状态 ======
        function showLoading() {
            const div = document.createElement('div');
            div.className = 'message assistant';
            div.id = 'loadingMessage';
            div.innerHTML = '🤔 思考中<span class="loading-dots"></span>';
            chatBox.appendChild(div);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function hideLoading() {
            const el = document.getElementById('loadingMessage');
            if (el) el.remove();
        }

        // ====== 调用 DeepSeek API ======
        async function callDeepSeek(userMessage) {
            if (!API_KEY) {
                addMessage('error', '⚠️ 请先设置 API Key');
                return;
            }

            // 显示用户消息
            addMessage('user', userMessage);

            // 清空输入框
            userInput.value = '';
            userInput.style.height = 'auto';

            // 显示加载状态
            showLoading();

            // 禁用发送按钮防止重复点击
            sendBtn.disabled = true;

            try {
                const response = await fetch('https://api.deepseek.com/chat/completions', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + API_KEY
                    },
                    body: JSON.stringify({
                        model: 'deepseek-chat',
                        messages: [
                            { role: 'system', content: '你是一个有用的AI助手，请用中文回复。' },
                            { role: 'user', content: userMessage }
                        ],
                        stream: false,
                        max_tokens: 4096,
                        temperature: 0.7
                    })
                });

                // 先读取响应文本，方便调试
                const responseText = await response.text();

                // 尝试解析 JSON
                let data;
                try {
                    data = JSON.parse(responseText);
                } catch (e) {
                    throw new Error('服务器返回了非JSON格式数据，请检查API Key是否有效');
                }

                // 隐藏加载
                hideLoading();

                if (!response.ok) {
                    // 处理 API 错误
                    const errorMsg = data.error ? data.error.message : '请求失败';
                    throw new Error('错误 ' + response.status + ': ' + errorMsg);
                }

                // 提取回复内容
                const reply = data.choices && data.choices[0] && data.choices[0].message
                    ? data.choices[0].message.content
                    : '未获取到有效回复';

                addMessage('assistant', reply);

            } catch (error) {
                hideLoading();
                let errorText = '❌ ' + error.message;
                // 如果是网络错误，给出更友好的提示
                if (error.message.includes('Failed to fetch') || error.message.includes('NetworkError')) {
                    errorText = '❌ 网络连接失败，请检查网络或API地址是否正确';
                } else if (error.message.includes('401') || error.message.includes('403')) {
                    errorText = '❌ API Key 无效或已过期，请重新输入';
                    // 清除保存的 Key
                    localStorage.removeItem('deepseek_api_key');
                    API_KEY = '';
                    enableChat(false);
                    apiKeyInput.value = '';
                }
                addMessage('error', errorText);
            } finally {
                sendBtn.disabled = false;
                userInput.focus();
            }
        }

        // ====== 发送按钮点击事件 ======
        sendBtn.addEventListener('click', function() {
            const msg = userInput.value.trim();
            if (!msg) return;
            if (!API_KEY) {
                addMessage('error', '⚠️ 请先设置 API Key');
                return;
            }
            callDeepSeek(msg);
        });

        // ====== 回车发送（Shift+Enter换行） ======
        userInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendBtn.click();
            }
        });

        // ====== 自动调整输入框高度 ======
        userInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });

        // ====== 页面加载完成后，如果有 Key 则聚焦输入框 ======
        window.addEventListener('load', function() {
            if (API_KEY) {
                userInput.focus();
            } else {
                apiKeyInput.focus();
            }
        });

        // ====== 额外：点击清空对话（在标题旁加个清除按钮，可选） ======
        // 在标题添加清空按钮
        const titleEl = document.querySelector('h1');
        const clearBtn = document.createElement('button');
        clearBtn.textContent = '🗑️ 清空';
        clearBtn.className = 'clear-btn';
        clearBtn.style.cssText = 'background:none;border:none;color:#9aa3b2;font-size:13px;cursor:pointer;padding:4px 8px;';
        clearBtn.addEventListener('click', function() {
            // 保留最新一条系统提示
            const msgs = chatBox.querySelectorAll('.message');
            // 如果只有一条且是欢迎语，保留；否则清空所有
            if (msgs.length <= 1) return;
            // 保留第一条
            const first = msgs[0];
            chatBox.innerHTML = '';
            chatBox.appendChild(first);
            // 如果当前有 Key，加一条就绪提示
            if (API_KEY) {
                addMessage('assistant', '✅ 对话已清空，可以继续提问。');
            } else {
                addMessage('assistant', '👋 请先输入 API Key 开始对话。');
            }
        });
        titleEl.style.cssText = 'display:flex;justify-content:space-between;align-items:center;';
        titleEl.appendChild(clearBtn);
    </script>

</body>
</html>
